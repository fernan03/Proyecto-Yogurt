    "components": {
        "schemas": {
            "Ingredient": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Nombre del ingrediente",
                        "example": "Leche entera"
                    },
                    "quantity": {
                        "type": "number",
                        "description": "Cantidad del ingrediente",
                        "format": "double",
                        "example": 1.0
                    },
                    "unit": {
                        "type": "string",
                        "description": "Unidad de medida",
                        "example": "litros"
                    },
                    "notes": {
                        "type": "string",
                        "description": "Notas adicionales sobre el ingrediente",
                        "example": "Preferiblemente fresca"
                    },
                    "options": {
                        "type": "boolean",
                        "description": "Indica si el ingrediente es opcional",
                        "example": false
                    }
                },
                "description": "Ingrediente utilizado en una receta de yogurt"
            },
            "Recipe": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "Nombre de la receta",
                        "example": "Yogurt natural clásico"
                    },
                    "description": {
                        "type": "string",
                        "description": "Descripción de la receta",
                        "example": "Receta tradicional de yogurt casero"
                    },
                    "defaulMilkVolume": {
                        "type": "number",
                        "description": "Volumen de leche en litros",
                        "format": "double",
                        "example": 1.0
                    },
                    "defaulStarterAmount": {
                        "type": "number",
                        "description": "Cantidad de cultivo iniciador (starter) en gramos",
                        "format": "double",
                        "example": 50.0
                    },
                    "heatingTemperature": {
                        "type": "number",
                        "description": "Temperatura de calentamiento en °C",
                        "format": "double",
                        "example": 85.0
                    },
                    "heatingDuration": {
                        "type": "integer",
                        "description": "Duración del calentamiento en minutos",
                        "format": "int32",
                        "example": 30
                    },
                    "innoculationTemperature": {
                        "type": "number",
                        "description": "Temperatura de inoculación en °C",
                        "format": "double",
                        "example": 43.0
                    },
                    "incubationTemperature": {
                        "type": "number",
                        "description": "Temperatura de incubación en °C",
                        "format": "double",
                        "example": 42.0
                    },
                    "minIncubationTime": {
                        "type": "integer",
                        "description": "Tiempo mínimo de incubación en minutos",
                        "format": "int32",
                        "example": 240
                    },
                    "maxIncubationTime": {
                        "type": "integer",
                        "description": "Tiempo máximo de incubación en minutos",
                        "format": "int32",
                        "example": 480
                    },
                    "refrigerationTime": {
                        "type": "integer",
                        "description": "Tiempo de refrigeración en minutos",
                        "format": "int32",
                        "example": 180
                    },
                    "difficulty": {
                        "type": "string",
                        "description": "Nivel de dificultad de la receta",
                        "example": "BEGINNER",
                        "enum": [
                            "BEGINNER",
                            "INTERMEDIATE",
                            "ADVANCED"
                        ]
                    },
                    "tips": {
                        "type": "string",
                        "description": "Consejos adicionales",
                        "example": "Mantener temperatura constante durante la incubación"
                    },
                    "ingredients": {
                        "type": "array",
                        "description": "Lista de ingredientes de la receta",
                        "items": {
                            "$ref": "#/components/schemas/Ingredient"
                        }
                    }
                },
                "description": "DTO para la creación y actualización de recetas de yogurt"
            },
            "StartBatchRequest": {
                "required": [
                    "recipeId"
                ],
                "type": "object",
                "properties": {
                    "recipeId": {
                        "type": "integer",
                        "description": "ID de la receta a utilizar",
                        "format": "int64",
                        "example": 1
                    },
                    "customMilkVolume": {
                        "type": "number",
                        "description": "Volumen personalizado de leche en litros (opcional)",
                        "format": "double",
                        "example": 2.0
                    },
                    "customStarterAmonunt": {
                        "type": "number",
                        "description": "Cantidad personalizada de cultivo iniciador en gramos (opcional)",
                        "format": "double",
                        "example": 100.0
                    }
                },
                "description": "Solicitud para iniciar un nuevo lote de yogurt"
            },
            "TemperatureLog": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int64"
