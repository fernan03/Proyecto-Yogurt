                            "PREPARING": 2,
                            "HEATING": 1,
                            "COOLING": 0,
                            "INCUBATING": 3,
                            "REFRIGERATING": 1,
                            "COMPLETED": 5,
                            "FAILED": 1
                        }
                    },
                    "activeBatchCount": {
                        "type": "integer",
