                        "format": "int64",
                        "example": 7
                    },
                    "completedToday": {
                        "type": "integer",
                        "description": "Cantidad de lotes completados hoy",
                        "format": "int32",
                        "example": 3
                    }
                },
                "description": "Resumen general del sistema de producción de yogurt"
            },
            "TemperatureSummary": {
                "type": "object",
                "properties": {
                    "currentTemperature": {
                        "type": "number",
                        "description": "Temperatura actual del lote en °C",
                        "format": "double",
                        "example": 42.5
                    },
                    "maximunTemperature": {
                        "type": "number",
                        "description": "Temperatura máxima registrada en °C",
                        "format": "double",
                        "example": 45.0
                    },
                    "minmumTemperature": {
                        "type": "number",
                        "description": "Temperatura mínima registrada en °C",
                        "format": "double",
                        "example": 38.5
                    },
                    "averageTemperature": {
                        "type": "number",
                        "description": "Temperatura promedio durante la incubación en °C",
