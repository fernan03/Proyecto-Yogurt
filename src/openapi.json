                            "INCUBATING",
                            "REFRIGERATING",
                            "COMPLETED",
                            "FAILED"
                        ]
                    },
                    "milkVolume": {
                        "type": "number",
                        "format": "double"
                    },
                    "starterAmount": {
                        "type": "number",
                        "format": "double"
                    },
                    "targetTemperature": {
                        "type": "number",
                        "format": "double"
                    },
                    "incubationTime": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "startTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "incubationStartTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "incubationEndTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "refrigerationStartTime": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "temperatureLogs": {
                        "type": "array",
