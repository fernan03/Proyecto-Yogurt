                            "HEATING",
                            "COOLING",
                            "INCUBATION",
                            "REFRIGERATION",
                            "MANUAL"
                        ]
                    },
                    "notes": {
                        "type": "string"
                    }
                }
            },
            "YogurtBatch": {
                "type": "object",
