                        "enum": [
                            "HEATING",
                            "COOLING",
                            "INCUBATION",
                            "REFRIGERATION",
                            "MANUAL",
                            "HEATING",
                            "COOLING",
                            "INCUBATION",
                            "REFRIGERATION",
                            "MANUAL"
                        ]
                    }
                },
