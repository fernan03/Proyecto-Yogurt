                            "$ref": "#/components/schemas/TemperatureLog"
                        }
                    },
                    "notes": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "TemperatureRecord": {
                "required": [
                    "temperature"
                ],
                "type": "object",
                "properties": {
                    "temperature": {
                        "type": "number",
